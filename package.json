{
  "name": "imap-email-mcp",
  "version": "1.1.0",
  "description": "MCP server that gives Claude and other AI tools email access over IMAP/SMTP: read, search, organize, reply with attachments, and send. Extended fork with safety guardrails and Proton Mail Bridge support.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "imap-email-mcp": "index.js"
  },
  "files": [
    "index.js",
    "save-password.ps1",
    "save-password.sh",
    "signature.example.txt",
    ".env.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "email",
    "imap",
    "smtp",
    "mail",
    "inbox",
    "gmail",
    "outlook",
    "email-client",
    "ai-tools",
    "llm-tools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aylacullen/imap-email-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aylacullen/imap-email-mcp/issues"
  },
  "homepage": "https://github.com/aylacullen/imap-email-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.7.2",
    "nodemailer": "10.3.1"
  }
}
