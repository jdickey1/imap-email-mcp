# Dependencies
node_modules/

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build outputs
dist/
build/

# Package manager locks: package-lock.json IS committed, so everyone gets the
# same tested dependency versions (e.g. the pinned nodemailer).

# Personal files the server creates or reads at runtime: never commit these
signature.txt
draft-threading.json

# Local backups
*.bak
*.bak-*
