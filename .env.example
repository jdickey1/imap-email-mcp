# IMAP Email MCP Server configuration
# These go in the "env" block of your MCP client config (Claude Desktop, Claude Code, Cursor).
# Full explanations: README.md

# Required
IMAP_USER=your-email@example.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=imap.example.com
# Alternative to IMAP_PASSWORD: the name of a password saved in Windows Credential Manager,
# the macOS Keychain, or the Linux keyring, created with save-password.ps1 (Windows) or
# save-password.sh (macOS/Linux). Then remove IMAP_PASSWORD:
# IMAP_PASSWORD_CREDENTIAL=imap-email-mcp

# Optional - IMAP connection (defaults shown)
# IMAP_PORT=993
# IMAP_TLS=true
# IMAP_AUTH_TIMEOUT=10000
# IMAP_TLS_REJECT_UNAUTHORIZED=true

# Optional - SMTP connection (defaults to IMAP values if not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=false     # set true when SMTP_SECURE=false (port 587) to refuse unencrypted sending
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password

# Optional - extra certificate to trust (Proton Mail Bridge: path to its exported cert.pem)
# NODE_EXTRA_CA_CERTS=C:\path\to\cert.pem

# Optional - features
# FROM_NAME=Your Name                      # sender name on outgoing mail
# SIGNATURE_FILE=/full/path/signature.txt  # default: signature.txt next to index.js
# ATTACHMENT_DIR=/full/path/Downloads/Email Attachments
# ATTACHMENT_BLOCK_DIRS=C:\Private;D:\Taxes # extra folders never to attach (";" on Windows, ":" on macOS/Linux)

# Common provider settings:
#
# Gmail:     IMAP_HOST=imap.gmail.com            SMTP_HOST=smtp.gmail.com
# Outlook:   IMAP_HOST=outlook.office365.com     SMTP_HOST=smtp.office365.com
#            SMTP_PORT=587  SMTP_SECURE=false  SMTP_REQUIRE_TLS=true
# Yahoo:     IMAP_HOST=imap.mail.yahoo.com       SMTP_HOST=smtp.mail.yahoo.com
# Fastmail:  IMAP_HOST=imap.fastmail.com         SMTP_HOST=smtp.fastmail.com
# iCloud:    IMAP_HOST=imap.mail.me.com          SMTP_HOST=smtp.mail.me.com
#            SMTP_PORT=587  SMTP_SECURE=false  SMTP_REQUIRE_TLS=true
# Proton Mail Bridge (Bridge set to SSL mode for IMAP and SMTP):
#            IMAP_HOST=127.0.0.1  IMAP_PORT=1143  IMAP_TLS=true
#            SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURE=true
#            NODE_EXTRA_CA_CERTS=<path to Bridge's exported cert.pem>
